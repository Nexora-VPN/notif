# The local stack's answers (docker-compose.yml). The install writes the same
# names from the manifest's options; here they are typed once.
NEXORA_OPT_ADMIN_USERNAME=admin
# At least 10 characters; used once, to make the first admin.
NEXORA_OPT_ADMIN_PASSWORD=change-me-please
# The code the panel presents when it registers Notif by hand.
NEXORA_CLAIM_CODE=LOCAL-NOTIF-0001
# The admin web's PrimeVue licence (optional: without it the web shows
# PrimeUI's licence notice).
VITE_PRIMEUI_LICENSE=
